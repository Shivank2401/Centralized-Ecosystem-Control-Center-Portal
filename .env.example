# Copy this file to ".env" and fill in paths for YOUR machine.
# Never commit .env — each user keeps their own paths.

# --- Client data roots (inventory / reports source trees) ---
# ESH: folder that contains us/, canada/, uk/, dashboard_essential_files/, …
ESH_DATA_ROOT=
# KNC: Kinetica client database root (contains Inventory/, Germany/, UAE/)
KNC_DATA_ROOT=
# EMAMI: Emami UAE tree (contains input/amazon|noon|noon_minutes/uae/…)
# EMAMI_DATA_ROOT="C:\path\to\Thrivebrands - Client Database\Emami"
# EMAMI_OUTPUT_ROOT=                      # optional; default sanity_data/EMM
# EMAMI_HELPER_FILE=                      # optional; default {EMAMI_DATA_ROOT}/input/helper_file/Emami (UAE)- Item Master Sheet.xlsx
# EMAMI_COGS_PATH=                        # optional placeholder (Emami report uses helper sheet, not COGS)
# PROCESS_YEAR=2026                       # optional; default current calendar year

# --- COGS workbooks (per client) ---
ESH_COGS_PATH=
KNC_COGS_PATH=

# --- Optional ESH path overrides (supply-chain a/b scripts) ---
# Parent of inventory (retail/, logistics/, Task file/). Default: parent of ESH_DATA_ROOT
# ESH_CENTRAL_ROOT=
# Full path to Country_helper.xlsx. Default: {ESH_DATA_ROOT}/dashboard_essential_files/Country_helper.xlsx
# ESH_COUNTRY_HELPER_PATH=
# Optional Demand_instock / helper_essential export root (outside inventory tree)
# ESH_DEMAND_INSTOCK_ROOT=
# EcoSoul revenue tree (Amazon orders). Default: {ESH_CENTRAL_ROOT}/revenue
# ESH_REVENUE_ROOT=
# EcoSoul retail tree (KeHE / Sprouts / item master). Default: {ESH_CENTRAL_ROOT}/retail
# ESH_RETAIL_ROOT="C:\path\to\...\Central Repository\retail"
# Walmart / Scintilla retail folder (sku_helper.csv, eComm Inventory.xlsx, …)
# ESH_WALMART_ROOT="C:\path\to\...\Retail & Food Service\Walmart"
# Local history masters written to: {ESH_WALMART_ROOT}/sanity_report/walmart_scintilla_*.csv

# --- Azure (ESH uploads: shipping queue, Walmart Scintilla, KeHE, Sprouts, …) ---
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# Or instead of connection string:
# AZURE_STORAGE_ACCOUNT_NAME=thriveclientdatabase
# AZURE_STORAGE_ACCOUNT_KEY=
# CONTAINER_NAME_ESH=thrive-client-ecosoulhome
# CONTAINER_NAME_KNC=thrive-client-kinetica
# Atros (KNC PNL / ads / decomposition) reads Bulk Ops / Transaction / BR under KNC_DATA_ROOT
# Optional month helper for AE path stamps:
# KNC_MONTH_HELPER_PATH=# CONTAINER_NAME_EMAMI=thrive-client-emami
# EMAMI_AZURE_CONNECTION_STRING=          # optional; falls back to AZURE_STORAGE_CONNECTION_STRING
# Walmart Scintilla blob folder (must match main_walmart_scintilla.py)
# WALMART_BLOB_PREFIX=sanity_data/retail
# Full path: {CONTAINER_NAME_ESH}/sanity_data/retail/walmart_scintilla_*.parquet
# KeHE / Sprouts CSV blobs (same folder):
#   kehe_age_inventory.csv, kehe_chain_store.csv, kehe_ksolve_overall.csv, kehe_inventory.csv
#   sprout_chain_store.csv, sprout_inventory.csv, sprouts_risk.csv
# RETAIL_BLOB_PREFIX=sanity_data/retail   # optional; defaults to WALMART_BLOB_PREFIX / sanity_data/retail

# --- Item Master Azure (fetch / update / delete parquet) ---
# ITEM_MASTER_AZURE_CONNECTION_STRING=   # optional; falls back to AZURE_STORAGE_CONNECTION_STRING
# ITEM_MASTER_CONTAINER=app-helper       # Azure blob container
# ITEM_MASTER_BLOB_PREFIX=item_master    # folder inside container
# Blob layout: app-helper / item_master / {CLIENT}.parquet
# ITEM_MASTER_LOCAL_DIR=                 # optional; default sanity_data/item_master/{CLIENT}.parquet

# --- COGS / pincode (Stage: want_to_update under report_script/want_to_update/) ---
# COGS_AZURE_CONTAINER=app-helper        # optional; falls back to ITEM_MASTER_CONTAINER / app-helper
# Upload Excel → Azure: want_to_update → ESH COGS / KNC COGS
# Download Azure → local: supply_chain → Download COGS
# Local COGS: cogs/{esh|knc}/{country}_{channel}_cogs.parquet
# Local pincode: pincode/{cc}_amazon_pincode.csv
# ESH_PINCODE_PATH=                      # optional; default {ESH_DATA_ROOT}/dashboard_essential_files/pincode.xlsx

# --- Optional overrides ---
SANITY_DATA_ROOT=
# Used by common sanity + requirement_specific/SC_inventory (manage_fba / reserved parquets).
# PINCODE_DATA_DIR="C:\path\to\pincode"   # quote if path has spaces; default: repo /pincode
# INVENTORY_BASE=  (alias for ESH inventory root used by saving_raw_file)
#
# SC_inventory.py (ESH Inventory Supply Chain) also needs:
#   ESH_DATA_ROOT   — walmart / shipbob / AWD / 3G / Updike / India inputs + USA Platform temp output
#   ESH_COGS_PATH   — sheet ESH-Item_master (SKU / ON_* / Box / Case attrs)
#   SANITY_DATA_ROOT — ESH/manage_fba + ESH/reserved parquet snapshots

# --- Utility codes (Stage: utility_codes under report_script/utility_codes/) ---
# MySQL import (a_import_any_file_to_mysql.py) — password required; do not commit secrets
# MYSQL_HOST=192.168.50.148
# MYSQL_PORT=3306
# MYSQL_USER=datahive_esh_test
# MYSQL_PASSWORD=
# MYSQL_DATABASE=datahive_esh_test
# MYSQL_POOL_NAME=order_pool
# MYSQL_POOL_SIZE=12
# Image name export (b_check_duplicate_image.py)
# UTILITY_IMAGE_FOLDER=
# UTILITY_IMAGE_OUTPUT=image_list.csv
